{
  "name": "hourboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.server.json && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "e2e": "npm run e2e:phase1 && npm run e2e:phase2",
    "e2e:phase1": "tsx tests/e2e/run-e2e.ts",
    "e2e:phase2": "tsx tests/e2e/run-ui-e2e.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fastify": "^5.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}

{
  "name": "hourboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "e2e": "npm run e2e:phase1",
    "e2e:phase1": "tsx tests/e2e/run-e2e.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
